{
  "name": "open-p",
  "version": "0.37.2",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openp": "./dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && chmod +x dist/src/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "test": "tsx --test --test-concurrency=1 test/*/*.test.ts",
    "test:claude": "tsx --test --test-concurrency=1 test/claude/*.test.ts",
    "test:codex": "tsx --test --test-concurrency=1 test/codex/*.test.ts",
    "test:kiro": "tsx --test --test-concurrency=1 test/kiro/*.test.ts",
    "test:opencode": "tsx --test --test-concurrency=1 test/opencode/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
