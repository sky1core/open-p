*.md
!/README.md

*.local.md

# Everything dot-prefixed is ignored by default, at every level. Tooling drops
# state, caches, and secrets into dot-directories without asking; an allow-list is the
# only form of this that does not leak the next one.
# Add an exception only for a file this repo publishes on purpose.
.*
!/.gitignore

# Development scripts are kept local. Nothing published consumes them: the npm package ships only
# dist/ and README.md.
scripts/

node_modules/
dist/
coverage/
npm-debug.log*
*.log
